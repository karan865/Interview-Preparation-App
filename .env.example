# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Set your MongoDB URI here. If left empty or unreachable in local dev/testing, the app falls back to an embedded in-memory MongoDB instance for zero-friction setup.
MONGODB_URI=mongodb://127.0.0.1:27017/interview_revision_db

# JWT Configuration
JWT_SECRET=super_secret_interview_revision_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origins
CORS_ORIGIN=*

# Admin Seeding Defaults
ADMIN_NAME=Admin Developer
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=AdminPassword123!
